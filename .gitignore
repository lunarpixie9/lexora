# Datasets: raw downloads and processed copies are never committed.
# Only data/README.md, data/metadata/, and small documented samples are tracked.
data/raw/
data/processed/
data/**/*.zip
data/**/*.mp3
data/**/*.wav
data/**/*.dat

# Python
__pycache__/
*.pyc
.venv/
venv/

# Node
node_modules/
dist/

# Secrets / local config
.env
.env.*
!.env.example
~/.kaggle/
kaggle.json

# OS / editor
desktop.ini
Thumbs.db
.DS_Store
.vscode/
.idea/

# Backend runtime state (SQLite DB, uploaded recordings, converted audio)
backend/storage/
.pytest_cache/

# Frontend
frontend/node_modules/
frontend/dist/

# Whisper model cache lives in the user's home (~/.cache/huggingface), not here
