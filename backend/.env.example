# Copy to backend/.env and edit. Never commit .env.

# Database: SQLite needs no setup (default). For the spec's MySQL target use e.g.
# DATABASE_URL=mysql+pymysql://lexora:password@localhost:3306/lexora
DATABASE_URL=sqlite:///./storage/lexora.db

# JWT signing secret — change this to a long random string
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_MINUTES=720

# Where uploaded recordings and generated files are stored (local storage backend)
STORAGE_DIR=./storage

# Speech: faster-whisper model size (tiny|base|small|medium). Leave empty to disable
# Whisper and use the clearly-labelled demo transcriber.
WHISPER_MODEL=small
WHISPER_DEVICE=cpu

# Pronunciation layer: a phoneme recogniser (no language model) that hears what was
# actually said and flags mispronounced words Whisper would silently "repair".
# Downloads ~1.2 GB once; needs ~1.5 GB RAM. Leave empty to disable on small machines.
PRONUNCIATION_MODEL=facebook/wav2vec2-xlsr-53-espeak-cv-ft

# Personalised practice: optional Google Gemini free-tier key. Leave empty and the
# deterministic local generator is used (clearly labelled in the UI).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Seed demo accounts and a demo child on first start (true/false)
SEED_DEMO=true
DEMO_PASSWORD=lexora123

# Comma-separated origins allowed to call the API
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
